{
  "expo": {
    "name": "reservas-deportivas-app",
    "slug": "reservas-deportivas-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "reservasdeportivasapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.camivillafane.reservasdeportivas",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para verificar tu identidad antes de escanear reservas."
      }
    },
    "android": {
      "package": "com.camivillafane.reservasdeportivas",
      "adaptiveIcon": {
        "backgroundColor": "#e9e9eb",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e9e9eb",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0e1311",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-image",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app usa tu ubicacion para mostrarte los espacios deportivos mas cercanos."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app usa tus fotos y videos para mostrarlos en la ficha de cada espacio."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La app usa la cámara para escanear el código QR de las reservas.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para verificar tu identidad antes de escanear reservas."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
